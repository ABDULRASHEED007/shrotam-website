# SHROTAM — Environment Variables
# Copy to .env.local and fill in values for local / production use.

# Site
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Contact form delivery (set at least one for real delivery)
# Resend email
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=SHROTAM Website <onboarding@resend.dev>
# Or POST enquiries to your CRM / automation tool
CRM_WEBHOOK_URL=

# --- Voice agent / CPaaS (configure when you connect a provider) ---
# Provider credentials belong in the agent runtime / vault, not the marketing site.
# Before production dialing, the Client must accept the provider's ToS, AUP,
# Privacy Policy, and AI Addendum (see src/config/cpaas-compliance.ts).
#
# CPAAS_PROVIDER=plivo
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
